# Plantilla de producción -- copiar a .env en el VPS y rellenar los valores
# marcados con <...>. Ver deploy/README.md. Solo se documentan aquí los
# valores que cambian respecto a .env.example; el resto (SESSION_*,
# BCRYPT_ROUNDS, etc.) se queda igual.

APP_NAME="PadelProTour"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.padelprotour.es

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_LEVEL=error

# Postgres del propio VPS (ver deploy/README.md paso 2).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=padelprotour
DB_USERNAME=padelprotour
DB_PASSWORD=<generada al crear la base de datos>

BROADCAST_CONNECTION=reverb
# Genera 3 valores aleatorios propios para producción -- no reutilices los
# de local/desarrollo (p.ej. `php artisan tinker --execute='echo Str::random(32);'`).
REVERB_APP_ID=<nuevo>
REVERB_APP_KEY=<nuevo>
REVERB_APP_SECRET=<nuevo>
# Host/puerto/scheme "públicos" que ven los clientes (el proceso real
# escucha en 127.0.0.1:8080, Nginx hace de proxy -- ver deploy/nginx.conf).
REVERB_HOST=api.padelprotour.es
REVERB_PORT=443
REVERB_SCHEME=https

FILESYSTEM_DISK=local
# database es suficiente a este tamaño -- no hace falta Redis para
# lanzar. El worker sistemd (deploy/queue-worker.service) ya lo cubre.
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=resend
RESEND_API_KEY=<API key de Resend>
# Solo funciona una vez verificado el dominio en resend.com/domains
# (deploy/README.md paso 7) -- hasta entonces sigue en modo sandbox.
MAIL_FROM_ADDRESS="no-reply@padelprotour.es"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_IDS=<los mismos que en local>
APPLE_CLIENT_IDS=<los mismos que en local>
