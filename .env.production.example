# Plantilla de producción -- copiar a .env en el VPS y rellenar los valores
# marcados con <...>. Ver deploy/README.md. Solo se documentan aquí los
# valores que cambian respecto a .env.example; el resto (SESSION_*,
# BCRYPT_ROUNDS, etc.) se queda igual.

APP_NAME="PadelProTour"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.padelprotour.net
FRONTEND_URL=https://padelprotour.net

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_LEVEL=error

# Postgres del propio VPS (ver deploy/README.md paso 2).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=padelprotour
DB_USERNAME=padelprotour
DB_PASSWORD=<generada al crear la base de datos>

BROADCAST_CONNECTION=reverb
# Genera 3 valores aleatorios propios para producción -- no reutilices los
# de local/desarrollo (p.ej. `php artisan tinker --execute='echo Str::random(32);'`).
REVERB_APP_ID=<nuevo>
REVERB_APP_KEY=<nuevo>
REVERB_APP_SECRET=<nuevo>
# Host/puerto/scheme "públicos" que ven los clientes (el proceso real
# escucha en 127.0.0.1:8080, Nginx hace de proxy -- ver deploy/nginx.conf).
REVERB_HOST=api.padelprotour.net
REVERB_PORT=443
REVERB_SCHEME=https

FILESYSTEM_DISK=local
# database es suficiente a este tamaño -- no hace falta Redis para
# lanzar. El worker sistemd (deploy/queue-worker.service) ya lo cubre.
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=resend
RESEND_API_KEY=<API key de Resend>
# Solo funciona una vez verificado el dominio en resend.com/domains
# (deploy/README.md paso 7) -- hasta entonces sigue en modo sandbox.
MAIL_FROM_ADDRESS="no-reply@padelprotour.net"
MAIL_FROM_NAME="${APP_NAME}"

# Client IDs de OAuth (públicos, no son secretos): web + iOS, separados por comas.
# Sin ellos, POST /auth/google rechaza todo token. El de web es el que valida
# tanto el login nativo (idToken) como el botón de Google de la web.
GOOGLE_CLIENT_IDS=370159415241-10mno6l5ro15tvn361o8pq60d8m7dud1.apps.googleusercontent.com,370159415241-s3jkr63tcnlem9dfs5fd1li67flmq81o.apps.googleusercontent.com
APPLE_CLIENT_IDS=<los mismos que en local>

# Monitorización. Sin SENTRY_LARAVEL_DSN Sentry queda desactivado (no falla nada).
# El DSN es una URL pública del proyecto de Sentry, no un secreto.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
# Email al que avisa deploy/healthcheck.sh cuando algo cae o se recupera.
ALERT_EMAIL=

# Roles de base de datos (los rellena deploy/setup-db-roles.sh; ver deploy/DESPLEGAR.md).
# DB_USERNAME/DB_PASSWORD pasan a ser el rol SIN permisos de estructura (padelprotour_app).
DB_MIGRATE_USERNAME=
DB_MIGRATE_PASSWORD=
DB_BACKUP_USERNAME=
DB_BACKUP_PASSWORD=
